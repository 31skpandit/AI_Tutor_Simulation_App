="0" y="1380" width="1740" height="1060" as="geometry"/></mxCell><mxCell id="s2_title" value="3 · Answering a question from the textbook (app/rag/tutor.py, store.py, answer_cache.py)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="1600" height="40" as="geometry"/></mxCell><mxCell id="s2_q" value="Question typed&lt;br&gt;(filters: class / subject / chapter; language)" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1460" width="220" height="70" as="geometry"/></mxCell><mxCell id="s2_emb" value="Embed the question&lt;br&gt;qwen3-embedding:0.6b" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="100" y="1560" width="220" height="60" as="geometry"/></mxCell><mxCell id="s2_dc" value="Similar question answered before?&lt;br&gt;similarity ≥ 0.97, same filters &amp; language,&lt;br&gt;index unchanged, no contrast words" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="1650" width="260" height="130" as="geometry"/></mxCell><mxCell id="s2_hit" value="♻️ Show the saved answer&lt;br&gt;(instant, free)" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="1680" width="200" height="70" as="geometry"/></mxCell><mxCell id="s2_srch" value="Vector search (SQLite + NumPy)&lt;br&gt;top passages within the filters" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="100" y="1810" width="220" height="60" as="geometry"/></mxCell><mxCell id="s2_dr" value="Best match&lt;br&gt;≥ 0.50 relevance?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="1900" width="220" height="100" as="geometry"/></mxCell><mxCell id="s2_nc" value="“This is not covered in the uploaded&lt;br&gt;textbook pages.” (optional general&lt;br&gt;answer, clearly marked)" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="1915" width="240" height="75" as="geometry"/></mxCell><mxCell id="s2_orig" value="Take the ORIGINAL reviewed passages&lt;br&gt;(summaries only helped to find them)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="100" y="2030" width="220" height="70" as="geometry"/></mxCell><mxCell id="s2_dl" value="Language?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="2130" width="220" height="80" as="geometry"/></mxCell><mxCell id="s2_en" value="English: task &#x27;tutor_answer&#x27;&lt;br&gt;local qwen3:4b-instruct&lt;br&gt;or &#x27;tutor_answer_cloud&#x27; gpt-5-nano" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="430" y="2050" width="240" height="70" as="geometry"/></mxCell><mxCell id="s2_hm" value="Hindi / Marathi: task&lt;br&gt;&#x27;tutor_answer_indic&#x27; gpt-5.4-mini&lt;br&gt;(terms kept in English)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="430" y="2150" width="240" height="70" as="geometry"/></mxCell><mxCell id="s2_ans" value="Answer with citations [1] Ch. 5, page 2&lt;br&gt;+ source passages shown" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="2090" width="240" height="70" as="geometry"/></mxCell><mxCell id="s2_save" value="Save in answer cache&lt;br&gt;(question vector, scope, index generation)" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="2200" width="240" height="60" as="geometry"/></mxCell><mxCell id="s2_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_q" target="s2_emb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_emb" target="s2_dc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_dc" target="s2_hit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_dc" target="s2_srch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_srch" target="s2_dr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_dr" target="s2_nc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_dr" target="s2_orig"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_orig" target="s2_dl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e9" value="English" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_dl" target="s2_en"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e10" value="HI / MR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_dl" target="s2_hm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_en" target="s2_ans"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_hm" target="s2_ans"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s2_ans" target="s2_save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s2_n3" value="&lt;b&gt;Why these rules (measured):&lt;/b&gt;&lt;br&gt;• 0.50 threshold: in-chapter questions scored 0.70–0.84, unrelated 0.22–0.34.&lt;br&gt;• Generated descriptions once swapped acidity/basicity → the tutor only sees original text.&lt;br&gt;• SQLite reuses row ids → a generation counter invalidates old cached answers." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffce8;strokeColor=#b3a34a;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="800" y="1470" width="460" height="120" as="geometry"/></mxCell><mxCell id="s2_lg" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;container=0;" vertex="1" parent="1"><mxGeometry x="1320" y="1470" width="230" height="250" as="geometry"/></mxCell><mxCell id="s2_lg0" value="Screen (Streamlit page)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1335" y="1500" width="200" height="28" as="geometry"/></mxCell><mxCell id="s2_lg1" value="App code (Python)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1335" y="1536" width="200" height="28" as="geometry"/></mxCell><mxCell id="s2_lg2" value="AI model call" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1335" y="1572" width="200" height="28" as="geometry"/></mxCell><mxCell id="s2_lg3" value="Automatic check" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1335" y="1608" width="200" height="28" as="geometry"/></mxCell><mxCell id="s2_lg4" value="Decision" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1335" y="1644" width="200" height="34" as="geometry"/></mxCell><mxCell id="s2_lg5" value="Stored data" style="whiteSpace=wrap;html=1;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1335" y="1680" width="200" height="40" as="geometry"/></mxCell><mxCell id="s3_frame" value="" style="rounded=1;arcSize=2;fillColor=#fbfbfb;strokeColor=#bbbbbb;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1800" y="1380" width="1740" height="1060" as="geometry"/></mxCell><mxCell id="s3_title" value="4 · Every AI call goes through one router (app/llm/router.py + config/models.yaml)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1840" y="1400" width="1600" height="40" as="geometry"/></mxCell><mxCell id="s3_boot" value="App start" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1900" y="1460" width="180" height="50" as="geometry"/></mxCell><mxCell id="s3_sc" value="Startup security checks&lt;br&gt;LiteLLM version pinned &amp; not 1.82.7/8 · no .pth hijack ·&lt;br&gt;no keys in .env · Ollama on localhost · Streamlit localhost" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1860" y="1540" width="260" height="90" as="geometry"/></mxCell><mxCell id="s3_dsc" value="All OK?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1900" y="1660" width="180" height="80" as="geometry"/></mxCell><mxCell id="s3_refuse" value="Refuse to start&lt;br&gt;(LiteLLM never imported)" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2160" y="1670" width="180" height="60" as="geometry"/></mxCell><mxCell id="s3_imp" value="Import LiteLLM (SDK only, local price list,&lt;br&gt;no callbacks)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1900" y="1770" width="180" height="70" as="geometry"/></mxCell><mxCell id="s3_call" value="complete(task, messages)&lt;br&gt;e.g. &#x27;ocr&#x27;, &#x27;tutor_answer&#x27;, &#x27;simulation_code&#x27;" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#60a917;fontColor=#ffffff;strokeColor=#2D7600;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2380" y="1460" width="240" height="60" as="geometry"/></mxCell><mxCell id="s3_spec" value="Read the task from models.yaml&lt;br&gt;primary + fallbacks, max_tokens,&lt;br&gt;json_output, ollama_options" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2380" y="1550" width="240" height="70" as="geometry"/></mxCell><mxCell id="s3_dcache" value="Same request&lt;br&gt;cached?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2380" y="1650" width="240" height="80" as="geometry"/></mxCell><mxCell id="s3_cached" value="Return cached answer ($0)" style="whiteSpace=wrap;html=1;fontSize=12;ellipse;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2680" y="1660" width="180" height="60" as="geometry"/></mxCell><mxCell id="s3_next" value="Next model in the list" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="2380" y="1760" width="240" height="50" as="geometry"/></mxCell><mxCell id="s3_dhost" value="Host on the&lt;br&gt;allow-list?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2380" y="1840" width="240" height="80" as="geometry"/></mxCell><mxCell id="s3_dpaid" value="Paid model: key in Credential&lt;br&gt;Manager, under monthly cap ($5),&lt;br&gt;premium approved?" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2370" y="1950" width="260" height="110" as="geometry"/></mxCell><mxCell id="s3_send" value="Call the model via LiteLLM&lt;br&gt;(retry on short failures)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="2380" y="2090" width="240" height="60" as="geometry"/></mxCell><mxCell id="s3_dok" value="Success?" style="whiteSpace=wrap;html=1;fontSize=12;