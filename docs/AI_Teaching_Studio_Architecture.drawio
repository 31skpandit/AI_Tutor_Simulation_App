<mxfile host="app.diagrams.net" type="device"><diagram id="architecture" name="Complete architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h_title" value="AI Teaching Studio — complete codebase architecture &amp; workflows" style="text;html=1;fontSize=34;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="50" as="geometry"/></mxCell><mxCell id="h_guide" value="&lt;b&gt;How to read this map&lt;/b&gt; (zoom out to see everything, zoom in to read a section; generated from the code by docs/_source/gen_drawio.py on 07-Oct-2026):&lt;br&gt;&lt;b&gt;1&lt;/b&gt; System overview — the layers: screens → app code → AI router → models, data and browser parts. &lt;b&gt;2&lt;/b&gt; Adding a textbook chapter — files to searchable passages. &lt;b&gt;3&lt;/b&gt; AI Tutor — how a question is answered from the textbook.&lt;br&gt;&lt;b&gt;4&lt;/b&gt; LLM router — what happens on every AI call (security, budget, fallbacks). &lt;b&gt;5&lt;/b&gt; Lessons &amp;amp; simulations — plan, checks ①–⑤, teacher approval, Teach Mode. &lt;b&gt;6&lt;/b&gt; 3D chemistry scenes — how electron/atom animations are computed without AI.&lt;br&gt;&lt;b&gt;7&lt;/b&gt; Code map — which folder/file does what. &lt;b&gt;8&lt;/b&gt; Teacher workflow — the daily steps. Colours: blue = screen · green = app code · purple = AI model · yellow = automatic check · orange diamond = decision · grey cylinder = stored data · green circle = start · blue circle = result · red = stop / refused." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffce8;strokeColor=#b3a34a;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="3540" height="150" as="geometry"/></mxCell><mxCell id="s0_frame" value="" style="rounded=1;arc