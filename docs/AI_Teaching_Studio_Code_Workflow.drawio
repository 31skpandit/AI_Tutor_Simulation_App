<mxfile host="app.diagrams.net" type="device"><diagram id="code" name="Code workflow and stack"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;AI Teaching Studio — code workflow: file → function → what it does, and the technology stack&lt;/b&gt;" style="text;html=1;fontSize=30;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="3000" height="50" as="geometry"/></mxCell><mxCell id="guide" value="&lt;b&gt;How to read:&lt;/b&gt; Part A (top) lists every technology used and why. Part B follows the app from the start command to the classroom: each coloured lane is one stage; inside a lane read the boxes &lt;b&gt;left → right&lt;/b&gt; (a lane continues on its next row). Every box shows &lt;b&gt;file&lt;/b&gt; → &lt;b&gt;function()&lt;/b&gt; and, in grey, what it does. Purple dashed arrows = an AI call through the router (lane 5).&lt;br&gt;&lt;b&gt;Colours:&lt;/b&gt; blue = screen (ui/) · green = Python app code (app/) · purple = AI model / router · yellow = check or security · grey = database · orange = JavaScript in the browser (assets/) · white dashed = outside tool. Generated from the code by docs/_source/gen_code_workflow.py (07-Oct-2026)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffce8;strokeColor=#b3a34a;fontSize=14;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="55" width="3000" height="80" as="geometry"/></mxCell><mxCell id="partA" value="&lt;b&gt;PART A — Technology stack (what is used, version, and why)&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="3000" height="36" as="geometry"/></mxCell><mxCell id="st0" value="&lt;b&gt;Runtime &amp; packaging&lt;/b&gt;" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="370" height="360" as="geometry"/></mxCell><mxCell id="st0_0" value="&lt;b&gt;Python 3.12.14&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;the language of all app code&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="10" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st0_1" value="&lt;b&gt;uv 0.12&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;installs packages only from uv.lock (SHA-256 hashes); `uv run …`&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="10" y="287" width="350" height="46" as="geometry"/></mxCell><mxCell id="st0_2" value="&lt;b&gt;Windows 11 + RTX 3050 4 GB&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;everything runs on the teacher&#x27;s laptop&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="10" y="339" width="350" height="46" as="geometry"/></mxCell><mxCell id="st0_3" value="&lt;b&gt;Node.js 24&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;syntax check of simulations; builds the Word docs&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="10" y="391" width="350" height="46" as="geometry"/></mxCell><mxCell id="st1" value="&lt;b&gt;User interface&lt;/b&gt;" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="376" y="200" width="370" height="360" as="geometry"/></mxCell><mxCell id="st1_0" value="&lt;b&gt;Streamlit 1.64.0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;web pages at localhost:8501 (ui/)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="386" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st1_1" value="&lt;b&gt;streamlit components&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;sealed iframes for simulations &amp; 3D&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="386" y="287" width="350" height="46" as="geometry"/></mxCell><mxCell id="st1_2" value="&lt;b&gt;Microsoft Edge (headless)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;hidden browser that tests simulations&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="386" y="339" width="350" height="46" as="geometry"/></mxCell><mxCell id="st2" value="&lt;b&gt;AI models&lt;/b&gt;" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="752" y="200" width="370" height="360" as="geometry"/></mxCell><mxCell id="st2_0" value="&lt;b&gt;LiteLLM 1.102.1 (SDK)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;one interface to Ollama and OpenAI&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="762" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st2_1" value="&lt;b&gt;Ollama 0.34&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;runs local models free on the GPU&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="762" y="287" width="350" height="46" as="geometry"/></mxCell><mxCell id="st2_2" value="&lt;b&gt;qwen3:4b-instruct&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;local text: tutor, page summaries&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="762" y="339" width="350" height="46" as="geometry"/></mxCell><mxCell id="st2_3" value="&lt;b&gt;qwen3-vl:2b-instruct&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;local vision: OCR of page images; checks lesson photos&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="762" y="391" width="350" height="46" as="geometry"/></mxCell><mxCell id="st2_4" value="&lt;b&gt;qwen3-embedding:0.6b&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;local embeddings for search&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="762" y="443" width="350" height="46" as="geometry"/></mxCell><mxCell id="st2_5" value="&lt;b&gt;OpenAI gpt-5-nano / 5.4-mini / 5.2&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;cloud: cheap answers, lessons, simulations, picture review, premium&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="762" y="495" width="350" height="46" as="geometry"/></mxCell><mxCell id="st3" value="&lt;b&gt;Data &amp; settings&lt;/b&gt;" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1128" y="200" width="370" height="360" as="geometry"/></mxCell><mxCell id="st3_0" value="&lt;b&gt;SQLite (WAL)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;one file data/app.db for everything&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1138" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st3_1" value="&lt;b&gt;SQLModel 0.0.47&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;tables as Python classes (app/db/models.py)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1138" y="287" width="350" height="46" as="geometry"/></mxCell><mxCell id="st3_2" value="&lt;b&gt;NumPy 2.5.3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;vector search (cosine similarity)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1138" y="339" width="350" height="46" as="geometry"/></mxCell><mxCell id="st3_3" value="&lt;b&gt;pydantic-settings 2.15.0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;settings from .env (ATS_*)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1138" y="391" width="350" height="46" as="geometry"/></mxCell><mxCell id="st3_4" value="&lt;b&gt;PyYAML 6.0.3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;reads config/models.yaml&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1138" y="443" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4" value="&lt;b&gt;Documents &amp; chemistry&lt;/b&gt;" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1504" y="200" width="370" height="456" as="geometry"/></mxCell><mxCell id="st4_0" value="&lt;b&gt;PyMuPDF 1.28.2&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;PDF text and page images&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_1" value="&lt;b&gt;python-docx 1.2.0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;Word files&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="287" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_2" value="&lt;b&gt;Pillow 12.3.0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;photos / page images&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="339" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_3" value="&lt;b&gt;RDKit 2026.3.6&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;molecule structures, 2D/3D coordinates, bonds&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="391" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_4" value="&lt;b&gt;in-house chemistry.py&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;equation balancing checker&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="443" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_5" value="&lt;b&gt;Natural Earth (India view)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;offline map outlines, India&#x27;s official boundaries&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="495" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_6" value="&lt;b&gt;GeoNames India&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;563 000 places for the history maps (CC BY 4.0)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="547" width="350" height="46" as="geometry"/></mxCell><mxCell id="st4_7" value="&lt;b&gt;Wikimedia Commons · Wikidata · Openverse&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;free-licence real-life photos (CC0 / PD / CC BY / BY-SA)&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1514" y="599" width="350" height="46" as="geometry"/></mxCell><mxCell id="st5" value="&lt;b&gt;Browser libraries (offline)&lt;/b&gt;" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1880" y="200" width="370" height="360" as="geometry"/></mxCell><mxCell id="st5_0" value="&lt;b&gt;p5.js 2.3.3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;drawing engine of simulations&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1890" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st5_1" value="&lt;b&gt;3Dmol.js 2.5.5&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;rotatable 3D molecule models&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1890" y="287" width="350" height="46" as="geometry"/></mxCell><mxCell id="st5_2" value="&lt;b&gt;labkit.js (hand-written)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;layout, labels, controls, apparatus&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1890" y="339" width="350" height="46" as="geometry"/></mxCell><mxCell id="st5_3" value="&lt;b&gt;chem3d.js (hand-written)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;3D electron / reaction player&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1890" y="391" width="350" height="46" as="geometry"/></mxCell><mxCell id="st5_4" value="&lt;b&gt;historykit.js (hand-written)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;timeline, map, cause → effect player&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1890" y="443" width="350" height="46" as="geometry"/></mxCell><mxCell id="st5_5" value="&lt;b&gt;mathkit.js (hand-written)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;factor tree, Venn, angles, 3D ramp/door/clock&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="1890" y="495" width="350" height="46" as="geometry"/></mxCell><mxCell id="st6" value="&lt;b&gt;Security &amp; quality&lt;/b&gt;" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="2256" y="200" width="370" height="360" as="geometry"/></mxCell><mxCell id="st6_0" value="&lt;b&gt;keyring 25.7.0&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27;&gt;API keys in Windows Credential Manager&lt;/font&gt;" style="whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;spacingRight=4;verticalAlign=top;spacingTop=4;rounded=1;fillColor=#ffffff;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="2266" y="235" width="350" height="46" as="geometry"/></mxCell><mxCell id="st6_1" value="&lt;b&gt;loguru 0.7.3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#555555&#x27